<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.trip.planner.mapper.TravelPlanMapper">

    <resultMap id="BaseResultMap" type="com.trip.planner.entity.TravelPlan">
        <id column="id" property="id"/>
        <result column="title" property="title"/>
        <result column="city" property="city"/>
        <result column="days" property="days"/>
        <result column="status" property="status"/>
        <result column="summary" property="summary"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, title, city, days, status, summary, created_at, updated_at
    </sql>

    <insert id="insert" parameterType="com.trip.planner.entity.TravelPlan" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO travel_plan (title, city, days, status, summary)
        VALUES (#{title}, #{city}, #{days}, #{status}, #{summary})
    </insert>

    <update id="update" parameterType="com.trip.planner.entity.TravelPlan">
        UPDATE travel_plan
        <set>
            <if test="title != null">title = #{title},</if>
            <if test="city != null">city = #{city},</if>
            <if test="days != null">days = #{days},</if>
            <if test="status != null">status = #{status},</if>
            <if test="summary != null">summary = #{summary},</if>
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM travel_plan WHERE id = #{id}
    </delete>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/> FROM travel_plan WHERE id = #{id}
    </select>

    <select id="selectAll" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/> FROM travel_plan ORDER BY created_at DESC
    </select>

</mapper>
