# ===== 部署环境变量 =====
# 复制本文件为 .env 并填入真实值：cp .env.example .env && vi .env

# MySQL（远程库，确保其安全组/白名单放行本 ECS 的公网 IP:3306）
MYSQL_HOST=101.34.51.42
MYSQL_PORT=3306
MYSQL_DB=trip_planning
MYSQL_USER=sceley
MYSQL_PASSWORD=请填写数据库密码

# 百度地图服务端 AK（后端 geocode / route 使用）
BAIDU_SERVER_AK=请填写服务端AK

# 火山方舟 AI Key
ARK_API_KEY=请填写AI接口Key

# CORS 允许的前端来源（可选）。留空即放行所有来源；
# 有域名后建议收紧，逗号分隔，如：http://1.2.3.4,https://trip.example.com
CORS_ALLOWED_ORIGINS=*
